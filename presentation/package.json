{
  "name": "scoop-mise-presentation",
  "version": "0.1.0",
  "description": "Support de la conférence quickie « Installer ses outils de dev avec Scoop et Mise »",
  "scripts": {
    "build": "node generate-qr.js && node build-deck.js",
    "build:deck": "node generate-qr.js && node build-deck.js",
    "dev:deck": "node --watch-path=src build-deck.js",
    "generate:qr": "node generate-qr.js",
    "verify": "cd .. && node scripts/verify-conference.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "predev": "npm run build",
    "dev": "node server.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "mermaid": "^12.0.0",
    "qrcode": "^1.5.4"
  }
}