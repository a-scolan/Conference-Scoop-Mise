<Configuration>
  <VGpu>Default</VGpu>
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\ascolan\Documents\Obsidian\Projects\OnePoint\Conférences\CFP\Installer ses outils de dev avec scoop et mise\demos</HostFolder>
      <SandboxFolder>C:\demos</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
